{
  "name": "obsidian-filedropper",
  "version": "1.0.2",
  "description": "Obsidian plugin: drop a file to insert a clickable link to it instead of copying it into the vault",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc && node esbuild.config.mjs production",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "license": "MIT",
  "type": "commonjs",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.6.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.14.4",
    "typescript": "~6.0",
    "typescript-eslint": "^8.74.0"
  }
}
